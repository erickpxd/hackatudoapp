{
  "ConnectionStrings": {
    "Hackatudo": "Host=localhost;Port=5432;Database=hackatudo;Username=hackatudo;Password=${HACKATUDO_DB_PASSWORD}"
  },
  "Jwt": {
    "Issuer": "Hackatudo.Api",
    "Audience": "Hackatudo.Clients",
    "SigningKey": "override-with-HACKATUDO_JWT_SIGNING_KEY-at-least-32-characters"
  },
  "AllowedHosts": "*"
}
